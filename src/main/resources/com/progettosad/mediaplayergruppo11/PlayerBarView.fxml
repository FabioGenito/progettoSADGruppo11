<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="bottomPlayerBar" prefHeight="105.0" style="-fx-background-color: #181818; -fx-border-color: #222222; -fx-border-width: 1 0 0 0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.progettosad.mediaplayergruppo11.controller.PlayerBarController">
    <children>
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" prefWidth="280.0" spacing="15.0">
                    <children>
                        <Region fx:id="currentTrackImage" maxHeight="-Infinity" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #2a2a2a; -fx-background-radius: 6;" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <children>
                                <Label fx:id="currentTrackTitle" text="Titolo brano" textFill="WHITE">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label fx:id="currentTrackArtist" text="Nome artista" textFill="#a7a7a7">
                                    <font><Font size="12.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox alignment="CENTER" prefWidth="500.0" spacing="8.0">
                    <children>
                        <HBox alignment="CENTER" spacing="25.0">
                            <children>
                                <ToggleButton fx:id="btnShuffle" style="-fx-background-color: transparent;" text="🔀" textFill="#a7a7a7">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></ToggleButton>
                                <Button fx:id="backButton" style="-fx-background-color: transparent;" text="⏮" textFill="WHITE" />
                                <Button fx:id="playerButton" onAction="#handlePlayPause" prefHeight="42.0" prefWidth="42.0" style="-fx-background-color: white; -fx-background-radius: 50;" text="▶" textFill="BLACK">
                                    <font><Font name="System Bold" size="20.0" /></font>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                                </Button>
                                <Button fx:id="skipButton" onAction="#handleNextTrack" style="-fx-background-color: transparent;" text="⏭" textFill="WHITE">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></Button>
                                <ToggleButton fx:id="btnLoop" style="-fx-background-color: transparent;" text="🔁" textFill="#a7a7a7">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor></ToggleButton>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Label fx:id="currentTrackTime" text="00:00" textFill="#a7a7a7" />
                                <ProgressBar fx:id="playerProgressBar" prefWidth="380.0" progress="0.0" style="-fx-accent: #1db954;" />
                                <Label fx:id="currentTrackDuration" text="00:00" textFill="#a7a7a7" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>
