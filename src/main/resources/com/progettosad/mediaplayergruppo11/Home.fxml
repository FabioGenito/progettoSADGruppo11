<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #121212; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" stylesheets="@HomeStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.progettosad.mediaplayergruppo11.controller.LibraryController">
   <children>
      
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="25.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
               <padding>
                  <Insets left="30.0" right="30.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <Button fx:id="homeButton" mnemonicParsing="false" style="-fx-background-color: #282828; -fx-background-radius: 50; -fx-cursor: hand;" text="⌂" textFill="WHITE">
                           <font><Font size="18.0" /></font>
                           <padding><Insets bottom="4.0" left="12.0" right="12.0" top="4.0" /></padding>
                        </Button>
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🧭" textFill="#a7a7a7">
                           <font><Font size="18.0" /></font>
                        </Button>
                        <Button fx:id="playlistButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="📂" textFill="#a7a7a7">
                           <font><Font size="18.0" /></font>
                        </Button>
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox fx:id="searchBar" alignment="CENTER" fillHeight="false" maxHeight="-Infinity" prefHeight="38.0" spacing="10.0" style="-fx-background-color: #242424; -fx-background-radius: 50;">
                     <padding><Insets left="18.0" right="18.0" /></padding>
                     <children>
                        <Label text="🔍" textFill="#a7a7a7" />
                        <TextField prefHeight="26.0" prefWidth="280.0" promptText="Cerca..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-padding: 0;" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </top>

         <left>
            <VBox prefWidth="240.0" spacing="15.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
               <padding><Insets bottom="10.0" left="20.0" right="15.0" top="25.0" /></padding>
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="LIBRERIA" textFill="#a7a7a7">
                           <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;" text="+" textFill="#a7a7a7">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Button>
                     </children>
                  </HBox>
                  <ListView fx:id="playlistListView" style="-fx-background-color: transparent; -fx-control-inner-background: #000000;" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </left>

         <center>
            <VBox spacing="20.0" style="-fx-background-color: #121212;" BorderPane.alignment="CENTER">
               <padding><Insets bottom="10.0" left="30.0" right="30.0" top="30.0" /></padding>
               <children>
                  <Label text="Brani suggeriti" textFill="WHITE">
                     <font><Font name="System Bold" size="26.0" /></font>
                  </Label>
                  <TableView fx:id="trackTableView" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colIndex" prefWidth="40.0" text="#" />
                        <TableColumn fx:id="colTitolo" prefWidth="300.0" styleClass="col-titolo-style" text="Titolo" />
                        <TableColumn fx:id="colArtista" prefWidth="200.0" text="Artista" />
                        <TableColumn fx:id="colAlbum" prefWidth="200.0" text="Album" />
                        <TableColumn fx:id="colDurata" prefWidth="80.0" text="⏱" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </center>

         <bottom>
            <VBox fx:id="bottomPlayerBar" prefHeight="105.0" style="-fx-background-color: #181818; -fx-border-color: #222222; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                     <padding><Insets left="25.0" right="25.0" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" prefWidth="280.0" spacing="15.0">
                           <children>
                              <Region fx:id="currentTrackImage" maxHeight="-Infinity" prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #2a2a2a; -fx-background-radius: 6;" />
                              <VBox alignment="CENTER_LEFT" spacing="2.0">
                                 <children>
                                    <Label fx:id="currentTrackTitle" text="Titolo brano" textFill="WHITE">
                                       <font><Font name="System Bold" size="14.0" /></font>
                                    </Label>
                                    <Label fx:id="currentTrackArtist" text="Nome artista" textFill="#a7a7a7">
                                       <font><Font size="12.0" /></font>
                                    </Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox alignment="CENTER" prefWidth="500.0" spacing="8.0">
                           <children>
                              <HBox alignment="CENTER" spacing="25.0">
                                 <children>
                                    <Button fx:id="shuffleButton" style="-fx-background-color: transparent;" text="🔀" textFill="#a7a7a7" />
                                    <Button fx:id="backButton" style="-fx-background-color: transparent;" text="⏮" textFill="WHITE" />
                                    <Button fx:id="playerButton" onAction="#handlePlayPause" prefHeight="42.0" prefWidth="42.0" style="-fx-background-color: white; -fx-background-radius: 50;" text="▶" textFill="BLACK">
                                       <font>
                                          <Font name="System Bold" size="20.0" />
                                       </font></Button>
                                    <Button fx:id="skipButton" style="-fx-background-color: transparent;" text="⏭" textFill="WHITE" />
                                    <Button fx:id="loopButton" style="-fx-background-color: transparent;" text="🔁" textFill="#a7a7a7" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER" spacing="12.0">
                                 <children>
                                    <Label fx:id="currentTrackTime" text="1:24" textFill="#a7a7a7" />
                                    <ProgressBar fx:id="playerProgressBar" prefWidth="380.0" progress="0.0" style="-fx-accent: #1db954;" />
                                    <Label fx:id="currentTrackDuration" text="3:50" textFill="#a7a7a7" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </bottom>
      </BorderPane>

      <Button fx:id="addTrackButton" layoutX="1000.0" layoutY="550.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="56.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-cursor: hand;" text="+" AnchorPane.bottomAnchor="130.0" AnchorPane.rightAnchor="30.0">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
         <effect>
            <DropShadow blurType="THREE_PASS_BOX" color="#000000a6" height="20.0" radius="9.5" width="20.0" />
         </effect>
      </Button>

   </children>
</AnchorPane>
