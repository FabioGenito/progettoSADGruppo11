<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="240.0" minWidth="240.0" prefWidth="240.0" spacing="15.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.progettosad.mediaplayergruppo11.controller.SidebarController">
   <padding>
      <Insets bottom="10.0" left="20.0" right="15.0" top="25.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label text="LIBRERIA" textFill="#a7a7a7">
               <font>
                  <Font name="System Bold" size="11.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCreatePlaylist" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;" text="+" textFill="#a7a7a7">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
      <ListView fx:id="playlistListView" style="-fx-background-color: transparent; -fx-control-inner-background: #000000;" VBox.vgrow="ALWAYS" />
   </children>
</VBox>