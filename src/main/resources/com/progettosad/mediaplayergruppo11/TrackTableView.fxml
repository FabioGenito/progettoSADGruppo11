<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.progettosad.mediaplayergruppo11.controller.TrackTableController">
    <padding>
        <Insets bottom="10.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <TableView fx:id="trackTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIndex" prefWidth="40.0" reorderable="false" resizable="false" text="#" />
                <TableColumn fx:id="colTitolo" prefWidth="250.0" reorderable="false" styleClass="col-titolo-style" text="Titolo" />
                <TableColumn fx:id="colArtista" prefWidth="180.0" reorderable="false" text="Artista" />
                <TableColumn fx:id="colAlbum" prefWidth="180.0" reorderable="false" text="Album" />
                
                <TableColumn fx:id="colGenere" prefWidth="120.0" reorderable="false" text="Genere" />
                <TableColumn fx:id="colAnno" prefWidth="70.0" reorderable="false" resizable="false" text="Anno" />
                
                <TableColumn fx:id="colDurata" prefWidth="60.0" reorderable="false" resizable="false" text="⏱" />
            </columns>
            
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>