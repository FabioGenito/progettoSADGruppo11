<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #121212; -fx-font-family: 'Inter', 'Segoe UI', sans-serif;" stylesheets="@view/styles/HomeStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.progettosad.mediaplayergruppo11.controller.MainShellController">
    <children>
      
        <BorderPane fx:id="mainBorderPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="25.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button fx:id="homeButton" mnemonicParsing="false" onAction="#openLibraryView" style="-fx-background-color: #282828; -fx-background-radius: 50; -fx-cursor: hand;" text="⌂" textFill="WHITE">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets bottom="4.0" left="12.0" right="12.0" top="4.0" />
                                    </padding>
                                </Button>
                                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🧭" textFill="#a7a7a7">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                                <Button fx:id="exploreButton" mnemonicParsing="false" onAction="#openExploreView" style="-fx-background-color: transparent; -fx-cursor: hand;" text="📂" textFill="#a7a7a7">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="searchBar" alignment="CENTER" fillHeight="false" maxHeight="-Infinity" prefHeight="38.0" spacing="10.0" style="-fx-background-color: #242424; -fx-background-radius: 50;">
                            <padding>
                                <Insets left="18.0" right="18.0" />
                            </padding>
                            <children>
                                <Label text="🔍" textFill="#a7a7a7" />
                                <TextField prefHeight="26.0" prefWidth="280.0" promptText="Cerca..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-padding: 0;" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </top>

            <left>
                <fx:include fx:id="sidebar" source="SidebarView.fxml" />
            </left>

         <center>
            <VBox spacing="10.0" style="-fx-background-color: #121212;" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  
                  <Label text="Creati per te" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  
                  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="200.0" style="-fx-background-color: transparent; -fx-control-inner-background: #121212; -fx-hbar-policy: NEVER; -fx-vbar-policy: NEVER;">
                     <content>
                        <HBox fx:id="consigliatiContainer" alignment="CENTER_LEFT" spacing="15.0" />
                     </content>
                  </ScrollPane>

                  <Region prefHeight="10.0" />

                  <Label text="Tutti i brani" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <fx:include fx:id="trackTable" source="TrackTableView.fxml" VBox.vgrow="ALWAYS" />
                  
               </children>
            </VBox>
         </center>

            <bottom>
                <fx:include fx:id="playerBar" source="PlayerBarView.fxml" />
            </bottom>
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>

        </BorderPane>

        <Button fx:id="addTrackButton" layoutX="1000.0" layoutY="550.0" mnemonicParsing="false" onAction="#handleAddTrack" prefHeight="56.0" prefWidth="56.0" style="-fx-background-color: white; -fx-background-radius: 50; -fx-cursor: hand;" text="+" AnchorPane.bottomAnchor="130.0" AnchorPane.rightAnchor="30.0">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <HBox fx:id="undoNotificationBox" alignment="CENTER_LEFT" prefHeight="59.0" prefWidth="332.0" spacing="15.0" style="-fx-background-color: #333333; -fx-padding: 12 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 4);" visible="false" AnchorPane.bottomAnchor="48.0" AnchorPane.rightAnchor="1.0">
            <children>
                <Label fx:id="undoMessageLabel" style="-fx-text-fill: white; -fx-font-family: 'Inter', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 14px;" text="Traccia aggiunta con successo!" />
                <Button fx:id="undoButton" mnemonicParsing="false" style="-fx-background-color: #FFF200; -fx-text-fill: black; -fx-font-family: 'Inter', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Annulla">
                    <padding>
                        <Insets bottom="6.0" left="15.0" right="15.0" top="6.0" />
                    </padding>
                </Button>
            </children>
        </HBox>

    </children>
</AnchorPane>
